# Copy to .env (`make up` does this automatically on first run).

# ── Ports published on the host ──
APP_PORT=3000
# Postgres is bound to 127.0.0.1 only.
DB_PORT=5433

# Time zone the server uses for "today" (IANA name, e.g. Asia/Amman).
# Browsers always use their own local date; this only affects server defaults.
TZ=UTC

# Optional Aladhan prayer-time method id (e.g. 23 = Jordan, 4 = Umm al-Qura).
# Leave empty to use the authority nearest to the user's location.
PRAYER_CALC_METHOD=

# ── Database (used by the db container and the app container) ──
POSTGRES_DB=habittracker
POSTGRES_USER=habittracker
# Set this BEFORE the first `make up`: Postgres only reads it when the database
# is created. To change it later, run inside the db container:
#   ALTER ROLE habittracker PASSWORD 'new-password';
# then update it here (and in DATABASE_URL below).
POSTGRES_PASSWORD=change-me

# Only used when running `npm run dev` on the host against the container DB.
# Inside Docker the app gets its own DATABASE_URL from docker-compose.yml.
DATABASE_URL=postgres://habittracker:change-me@localhost:5433/habittracker

# ── Gemini AI — SERVER ONLY. Never commit a real key. ──
# Used by the AI features (daily planner, goal breaker, weekly review).
GEMINI_API_KEY=
# Optional — defaults to gemini-2.5-flash if unset.
GEMINI_MODEL=gemini-2.5-flash

# Encryption secret — SERVER ONLY. Reserved for encrypting future OAuth
# tokens for learning-platform connections (src/lib/security/encryption.ts).
# No code path uses this yet since no OAuth provider is implemented.
ENCRYPTION_SECRET=
