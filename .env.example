# Supabase — copy to .env.local and fill in your project values
# Project URL (Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Public/anon key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Service role key — SERVER ONLY, never expose to the client
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Gemini AI — SERVER ONLY. Never expose to the client; never commit a real key.
# Used by the AI features (daily planner, goal breaker, weekly review).
GEMINI_API_KEY="your-gemini-api-key"
# Optional — defaults to gemini-2.5-flash if unset.
GEMINI_MODEL="gemini-2.5-flash"

# Encryption secret — SERVER ONLY. Reserved for encrypting future OAuth
# tokens for learning-platform connections (src/lib/security/encryption.ts).
# No code path uses this yet since no OAuth provider is implemented.
# Never hardcode a real value here or commit one.
ENCRYPTION_SECRET=
